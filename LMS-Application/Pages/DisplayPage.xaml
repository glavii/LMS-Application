<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LMS_Application.Pages.DisplayPage"
             xmlns:local="clr-namespace:LMS_Application"
             xmlns:pages="clr-namespace:LMS_Application.Pages"
             x:DataType="pages:DisplayPage"
             Title="List"
             BackgroundColor="#06AB78">
    <CollectionView ItemsSource="{Binding Livestocks}"
                    ItemsUpdatingScrollMode="KeepLastItemInView">
        <CollectionView.Header>
            <Grid BackgroundColor="#06AB78" ColumnDefinitions="*,*,*,*,*,*,*" Padding="5">
                <Label Grid.Column="0" Text="Type" TextColor="#ffffff"/>
                <Label Grid.Column="1" Text="Id" TextColor="#ffffff"/>
                <Label Grid.Column="2" Text="Expense" TextColor="#ffffff"/>
                <Label Grid.Column="3" Text="Weight" TextColor="#ffffff"/>
                <Label Grid.Column="4" Text="Colour" TextColor="#ffffff"/>
                <Label Grid.Column="5" Text="Milk" TextColor="#ffffff"/>
                <Label Grid.Column="6" Text="Wool" TextColor="#ffffff"/>
            </Grid>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:Livestock">
                <Border BackgroundColor="#ffffff" StrokeShape="RoundRectangle 10" Padding="5">
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <Label Grid.Column="0" Text="{Binding Type}" TextColor="#30313D"/>
                        <Label Grid.Column="1" Text="{Binding Id}" TextColor="#30313D"/>
                        <Label Grid.Column="2" Text="{Binding Expense}" TextColor="#30313D"/>
                        <Label Grid.Column="3" Text="{Binding Weight}" TextColor="#30313D"/>
                        <Label Grid.Column="4" Text="{Binding Colour}" TextColor="#30313D"/>
                        <Label Grid.Column="5" x:DataType="local:Cow" Text="{Binding Milk}" TextColor="#30313D"/>
                        <Label Grid.Column="6" x:DataType="local:Sheep" Text="{Binding Wool}" TextColor="#30313D"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
