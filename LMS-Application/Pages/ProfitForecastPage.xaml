<ContentPage x:Class="LMS_Application.Pages.ProfitForecastPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profit Forecast"
             BackgroundColor="{AppThemeBinding Light=#F7F7F5, Dark=#1C1C1E}">

    <ContentPage.Resources>
        <Style x:Key="PageH" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
        </Style>
        <Style x:Key="PageSub" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
        <Style x:Key="Section" TargetType="Label" BasedOn="{StaticResource PageSub}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Placeholder" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="InputTransparent" Value="True" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style x:Key="ResultText" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
        </Style>

        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2C}" />
            <Setter Property="Padding" Value="32" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAFAF9, Dark=#232325}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="Input" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="FieldPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4C8C4A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="620" HorizontalOptions="Fill" Margin="24,0"
                             Padding="0,40" Spacing="24">

            <VerticalStackLayout Spacing="4">
                <Label Text="Profit forecast" Style="{StaticResource PageH}" />
                <Label Text="Estimate profit for an investment over a number of days." Style="{StaticResource PageSub}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBox}">
                <VerticalStackLayout Spacing="30">

                    <!-- Type -->
                    <VerticalStackLayout>
                        <Label Text="LIVESTOCK TYPE" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Grid>
                                <Label Text="Select livestock type" Style="{StaticResource Placeholder}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding SelectedIndex, Source={x:Reference LivestockTypePicker}}"
                                                     Value="-1">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Picker x:Name="LivestockTypePicker"
                                        Style="{StaticResource FieldPicker}"
                                        ItemsSource="{Binding LivestockTypes}"
                                        SelectedIndexChanged="LivestockTypePicker_SelectedIndexChanged" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Quantity / Days -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="INVESTMENT QUANTITY" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry x:Name="Quantity" Placeholder="e.g. 10" Keyboard="Numeric"
                                           Style="{StaticResource Input}" />
                                    <Label Grid.Column="1" Text="head" Style="{StaticResource PageSub}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="FORECAST PERIOD" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry x:Name="ForecastDays" Placeholder="e.g. 30" Keyboard="Numeric"
                                           Style="{StaticResource Input}" />
                                    <Label Grid.Column="1" Text="days" Style="{StaticResource PageSub}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />

                    <HorizontalStackLayout HorizontalOptions="End">
                        <Button Text="Run forecast" Style="{StaticResource BtnPrimary}"
                                Clicked="ForecastButton_Clicked" />
                    </HorizontalStackLayout>

                    <!-- Result: border visibility follows ResultPanel.IsVisible, so code-behind is unchanged -->
                    <Border IsVisible="{Binding IsVisible, Source={x:Reference ResultPanel}}"
                            StrokeShape="RoundRectangle 10" StrokeThickness="1" Padding="20,16"
                            Stroke="#4C8C4A"
                            BackgroundColor="{AppThemeBinding Light=#E8EEE6, Dark=#2C3A2E}">
                        <VerticalStackLayout x:Name="ResultPanel" Spacing="8" IsVisible="False">
                            <Label Text="RESULT" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="AvgProfitLabel" Style="{StaticResource ResultText}" />
                            <Label x:Name="TotalProfitLabel" Style="{StaticResource ResultText}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>