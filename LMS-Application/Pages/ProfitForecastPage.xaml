<ContentPage x:Class="LMS_Application.Pages.ProfitForecastPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profit Forecast"
              BackgroundColor="#06AB78">
    <VerticalStackLayout Padding="20" Spacing="15" WidthRequest="400">

        <Label Text="Livestock Type" />
        <Picker x:Name="LivestockTypePicker"
                ItemsSource="{Binding LivestockTypes}"
                TextColor="White"
                BackgroundColor="#06AB78"
                SelectedIndexChanged="LivestockTypePicker_SelectedIndexChanged" />

        <Entry x:Name="Quantity" Placeholder="Enter investment quantity" Keyboard="Numeric" TextColor="Black" BackgroundColor="White"/>
        <Entry x:Name="ForecastDays" Placeholder="Enter number of days for forecast" Keyboard="Numeric" TextColor="Black" BackgroundColor="White"/>


        <Button Text="Forecast"  Clicked="ForecastButton_Clicked" BackgroundColor="White" TextColor="Black" BorderColor="LightGrey" BorderWidth="2"/>

        <VerticalStackLayout x:Name="ResultPanel" BackgroundColor="White" Padding="10" Spacing="5" IsVisible="False">
            <Label x:Name="AvgProfitLabel" TextColor="Black"/>
            <Label x:Name="TotalProfitLabel" TextColor="Black"/>
        </VerticalStackLayout>

    </VerticalStackLayout>
   

</ContentPage>