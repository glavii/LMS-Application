<ContentPage x:Class="LMS_Application.Pages.DataVisualisationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Visualisation"
             BackgroundColor="{AppThemeBinding Light=#F7F7F5, Dark=#1C1C1E}">

    <ContentPage.Resources>
        <Style x:Key="PageH" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
        </Style>
        <Style x:Key="PageSub" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
        <Style x:Key="Section" TargetType="Label" BasedOn="{StaticResource PageSub}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TileValue" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#2F5E2E, Dark=#8FC48D}" />
        </Style>
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2C}" />
            <Setter Property="Padding" Value="28" />
        </Style>
        <Style x:Key="TileBox" TargetType="Border" BasedOn="{StaticResource CardBox}">
            <Setter Property="Padding" Value="22,18" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="720" HorizontalOptions="Fill" Margin="24,0"
                             Padding="0,40" Spacing="24">

            <VerticalStackLayout Spacing="4">
                <Label Text="Livestock visualisation" Style="{StaticResource PageH}" />
                <Label Text="A visual summary of your herd." Style="{StaticResource PageSub}" />
            </VerticalStackLayout>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource CardBox}" IsVisible="False">
                <VerticalStackLayout Spacing="6" Padding="0,20">
                    <Label Text="No livestock yet" FontSize="16" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
                    <Label Text="Add an animal to see charts here." Style="{StaticResource PageSub}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="Dashboard" Spacing="24">

                <!-- Summary tiles -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource TileBox}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL ANIMALS" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="TotalCountLabel" Style="{StaticResource TileValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource TileBox}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL EXPENSE" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="TotalExpenseLabel" Style="{StaticResource TileValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource TileBox}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="AVERAGE WEIGHT" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="AvgWeightLabel" Style="{StaticResource TileValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TileBox}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="PRODUCE" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="ProduceLabel" Style="{StaticResource TileValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Charts -->
                <Border Style="{StaticResource CardBox}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="HERD BY TYPE" Style="{StaticResource Section}" Margin="0" />
                        <VerticalStackLayout x:Name="TypeCountChart" Spacing="10" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBox}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="HERD BY COLOUR" Style="{StaticResource Section}" Margin="0" />
                        <VerticalStackLayout x:Name="ColourChart" Spacing="10" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBox}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="TOTAL EXPENSE BY TYPE" Style="{StaticResource Section}" Margin="0" />
                        <VerticalStackLayout x:Name="ExpenseChart" Spacing="10" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBox}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="AVERAGE WEIGHT BY TYPE" Style="{StaticResource Section}" Margin="0" />
                        <VerticalStackLayout x:Name="WeightChart" Spacing="10" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>