<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LMS_Application.Pages.LivestockStatisticsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:LMS_Application.Pages"
             x:DataType="pages:LivestockStatisticsPage"
             Title="Livestock Statistics"
             BackgroundColor="{AppThemeBinding Light=#F7F7F5, Dark=#1C1C1E}">

    <ContentPage.Resources>
        <Style x:Key="PageH" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
        </Style>
        <Style x:Key="PageSub" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
        </Style>
        <Style x:Key="Section" TargetType="Label" BasedOn="{StaticResource PageSub}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Stat" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2C}" />
            <Setter Property="Padding" Value="32" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FAFAF9, Dark=#232325}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="Input" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="FieldPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F3F4F6}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4C8C4A" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout MaximumWidthRequest="620" HorizontalOptions="Fill" Margin="24,0"
                             Padding="0,40" Spacing="24">

            <VerticalStackLayout Spacing="4">
                <Label Text="Livestock statistics" Style="{StaticResource PageH}" />
                <Label Text="Filter your herd and project profit over time." Style="{StaticResource PageSub}" />
            </VerticalStackLayout>

            <!-- Filters -->
            <Border Style="{StaticResource CardBox}">
                <VerticalStackLayout Spacing="30">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="LIVESTOCK TYPE" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Picker x:Name="LivestockTypePicker"
                                        Style="{StaticResource FieldPicker}"
                                        ItemsSource="{Binding LivestockTypes}"
                                        SelectedIndex="0" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="COLOUR" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Picker x:Name="ColourPicker"
                                        Style="{StaticResource FieldPicker}"
                                        ItemsSource="{Binding ColourOptions}"
                                        SelectedIndex="0" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="DAYS TO PROJECT" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry x:Name="ProjectionDays" Placeholder="e.g. 30" Keyboard="Numeric"
                                       Style="{StaticResource Input}" />
                                <Label Grid.Column="1" Text="days" Style="{StaticResource PageSub}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error banner: border follows ErrorLabel.IsVisible, so code-behind is unchanged -->
                    <Border x:DataType="{x:Null}"
                            IsVisible="{Binding IsVisible, Source={x:Reference ErrorLabel}}"
                            StrokeShape="RoundRectangle 8" StrokeThickness="1" Padding="14,10"
                            Stroke="#C0392B"
                            BackgroundColor="{AppThemeBinding Light=#FDF2F0, Dark=#3A2522}">
                        <Label x:Name="ErrorLabel" IsVisible="False" FontSize="13" TextColor="#C0392B" />
                    </Border>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />

                    <HorizontalStackLayout HorizontalOptions="End">
                        <Button Text="Calculate" Style="{StaticResource BtnPrimary}"
                                Clicked="CalculateButton_Clicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Statistics result -->
            <Border x:DataType="{x:Null}"
                    IsVisible="{Binding IsVisible, Source={x:Reference ResultPanel}}"
                    Style="{StaticResource CardBox}">
                <VerticalStackLayout x:Name="ResultPanel" Spacing="14" IsVisible="False">
                    <Label Text="LIVESTOCK STATISTICS" Style="{StaticResource Section}" Margin="0" />

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Padding="20,16"
                            Stroke="#4C8C4A"
                            BackgroundColor="{AppThemeBinding Light=#E8EEE6, Dark=#2C3A2E}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL PROFIT" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="TotalProfitLabel" FontSize="22" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2F5E2E, Dark=#8FC48D}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="HERD" Style="{StaticResource Section}" Margin="0,8,0,0" />
                    <Label x:Name="SelectedCountLabel" Style="{StaticResource Stat}" />
                    <Label x:Name="PercentageLabel" Style="{StaticResource Stat}" />
                    <Label x:Name="AverageWeightLabel" Style="{StaticResource Stat}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />

                    <Label Text="FINANCE" Style="{StaticResource Section}" Margin="0" />
                    <Label x:Name="TotalTaxLabel" Style="{StaticResource Stat}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />

                    <Label Text="PRODUCE" Style="{StaticResource Section}" Margin="0" />
                    <Label x:Name="TotalProduceLabel" Style="{StaticResource Stat}" />
                    <Label x:Name="TotalMilkLabel" Style="{StaticResource Stat}" />
                    <Label x:Name="TotalWoolLabel" Style="{StaticResource Stat}" />
                </VerticalStackLayout>
            </Border>

            <!-- Daily profit -->
            <Border x:DataType="{x:Null}"
                    IsVisible="{Binding IsVisible, Source={x:Reference DailyProfitPanel}}"
                    Style="{StaticResource CardBox}">
                <VerticalStackLayout x:Name="DailyProfitPanel" Spacing="14" IsVisible="False">
                    <Label Text="DAILY PROFIT BREAKDOWN" Style="{StaticResource Section}" Margin="0" />

                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Padding="20,16"
                            Stroke="#4C8C4A"
                            BackgroundColor="{AppThemeBinding Light=#E8EEE6, Dark=#2C3A2E}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL PER DAY" Style="{StaticResource Section}" Margin="0" />
                            <Label x:Name="TotalDailyProfitLabel" FontSize="22" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2F5E2E, Dark=#8FC48D}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="BY TYPE" Style="{StaticResource Section}" Margin="0,8,0,0" />
                    <Label x:Name="DailyCowProfitLabel" Style="{StaticResource Stat}" />
                    <Label x:Name="DailySheepProfitLabel" Style="{StaticResource Stat}" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#3A3A3C}" />

                    <Label Text="AVERAGE PER ANIMAL" Style="{StaticResource Section}" Margin="0" />
                    <Label x:Name="AverageCowProfitLabel" Style="{StaticResource Stat}" />
                    <Label x:Name="AverageSheepProfitLabel" Style="{StaticResource Stat}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>