<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LMS_Application.Pages.DataPage"
             xmlns:local="clr-namespace:LMS_Application"
             xmlns:pages="clr-namespace:LMS_Application.Pages"
             x:DataType="pages:DataPage"
             Title="DataPage"
             BackgroundColor="White">
    <CollectionView ItemsSource="{Binding Livestocks}"
                    ItemsUpdatingScrollMode="KeepLastItemInView">
        <CollectionView.Header>
            <Grid BackgroundColor="LightBlue" ColumnDefinitions="*,*,*,*,*,*,*" Padding="5">
                <Label Grid.Column="0" Text="Type" TextColor="Black"/>
                <Label Grid.Column="1" Text="Id" TextColor="Black"/>
                <Label Grid.Column="2" Text="Expense" TextColor="Black"/>
                <Label Grid.Column="3" Text="Weight" TextColor="Black"/>
                <Label Grid.Column="4" Text="Colour" TextColor="Black"/>
                <Label Grid.Column="5" Text="Milk" TextColor="Black"/>
                <Label Grid.Column="6" Text="Wool" TextColor="Black"/>
            </Grid>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:Livestock">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 10" Padding="5">
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <Label Grid.Column="0" Text="{Binding Type}" TextColor="Black"/>
                        <Label Grid.Column="1" Text="{Binding Id}" TextColor="Black"/>
                        <Label Grid.Column="2" Text="{Binding Expense}" TextColor="Black"/>
                        <Label Grid.Column="3" Text="{Binding Weight}" TextColor="Black"/>
                        <Label Grid.Column="4" Text="{Binding Colour}" TextColor="Black"/>
                        <Label Grid.Column="5" x:DataType="local:Cow" Text="{Binding Milk}" TextColor="Black"/>
                        <Label Grid.Column="6" x:DataType="local:Sheep" Text="{Binding Wool}" TextColor="Black"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
