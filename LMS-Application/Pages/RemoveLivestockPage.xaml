<ContentPage x:Class="LMS_Application.Pages.RemoveLivestockPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LMS_Application"
             xmlns:pages="clr-namespace:LMS_Application.Pages"
             x:DataType="pages:RemoveLivestockPage"
             Title="Remove Livestock"
             BackgroundColor="#06AB78"
            >

    <VerticalStackLayout Padding="20" Spacing="15" WidthRequest="400">
        <Label Text="Remove records" FontAttributes="Bold" />

        <Label Text="Enter livestock id" />
        <Entry x:Name="IdEntry" Placeholder="Livestock ID" Keyboard="Numeric"  BackgroundColor="White" TextColor="Black"/>

        <Button Text="Remove" Clicked="DeleteButton_Clicked" BackgroundColor="White" TextColor="Black" />

        <!-- Reused row template from DataPage, bound to the single found record -->
        <CollectionView ItemsSource="{Binding FoundRecord}"
                        IsVisible="{Binding HasFoundRecord}">
            <CollectionView.Header>
                <Grid BackgroundColor="#06AB78" ColumnDefinitions="*,*,*,*,*,*,*" Padding="10" >
                    <Label Grid.Column="0" Text="Type" TextColor="White"/>
                    <Label Grid.Column="1" Text="Id" TextColor="White"/>
                    <Label Grid.Column="2" Text="Expense" TextColor="White"/>
                    <Label Grid.Column="3" Text="Weight" TextColor="White"/>
                    <Label Grid.Column="4" Text="Colour" TextColor="White"/>
                    <Label Grid.Column="5" Text="Milk" TextColor="White"/>
                    <Label Grid.Column="6" Text="Wool" TextColor="White"/>
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Livestock">
                    <Border BackgroundColor="Black" StrokeShape="RoundRectangle 10" Padding="5">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Grid.Column="0" Text="{Binding Type}" TextColor="White"/>
                            <Label Grid.Column="1" Text="{Binding Id}" TextColor="White"/>
                            <Label Grid.Column="2" Text="{Binding Expense}" TextColor="White"/>
                            <Label Grid.Column="3" Text="{Binding Weight}" TextColor="White"/>
                            <Label Grid.Column="4" Text="{Binding Colour}" TextColor="White"/>
                            <Label Grid.Column="5" x:DataType="local:Cow" Text="{Binding Milk}" TextColor="White"/>
                            <Label Grid.Column="6" x:DataType="local:Sheep" Text="{Binding Wool}" TextColor="White"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>