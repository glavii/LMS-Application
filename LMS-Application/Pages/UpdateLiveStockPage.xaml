<ContentPage x:Class="LMS_Application.Pages.UpdateLivestockPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Update Livestock"
              BackgroundColor="#06AB78">
    <VerticalStackLayout Padding="20" Spacing="15" WidthRequest="400">

        <Label Text="Select Livestock" />
        <Picker x:Name="LivestockIdPicker"
                ItemsSource="{Binding LivestockRecords}"
                ItemDisplayBinding="{Binding DisplayName}"
                SelectedIndexChanged="LivestockIdPicker_SelectedIndexChanged" />

        <BoxView HeightRequest="1" Color="Black" />

        <Label Text="Livestock Type" />
        <Picker x:Name="LivestockTypePicker"
                ItemsSource="{Binding LivestockTypes}"
                IsEnabled="False"
                TextColor="white"/>

        <Entry x:Name="ExpenseEntry" Placeholder="Expense" Keyboard="Numeric" />
        <Entry x:Name="WeightEntry" Placeholder="Weight" Keyboard="Numeric" />

        <Label Text="Colour" />
        <Picker x:Name="ColourPicker"
                ItemsSource="{Binding ColourOptions}" />

        <!-- Type-specific field -->
        <Entry x:Name="MilkEntry" Placeholder="Milk" Keyboard="Numeric" IsVisible="False" />
        <Entry x:Name="WoolEntry" Placeholder="Wool" Keyboard="Numeric" IsVisible="False" />

        <Button x:Name="SubmitButton" Text="Update" Clicked="UpdateButton_Clicked" IsEnabled="False" BackgroundColor="White" TextColor="Black"/>
    </VerticalStackLayout>
</ContentPage>