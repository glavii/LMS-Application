<Shell
    x:Class="LMS_Application.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LMS_Application.Pages"
    Title="Livestock Management System"
    FlyoutBehavior="Locked"
    FlyoutWidth="220"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light=#F7F7F5, Dark=#1C1C1E}"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,28,20,20" Spacing="2">
            <Label Text="LMS" FontSize="22" FontAttributes="Bold" />
            <Label Text="Livestock Management" FontSize="12" Opacity="0.55" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid ColumnDefinitions="4,*" Padding="0" HeightRequest="44" Margin="8,2">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="CommonStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light=#E8EEE6, Dark=#2C3A2E}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <BoxView Grid.Column="0" Color="#4C8C4A" CornerRadius="2"
                         IsVisible="{Binding IsChecked, Source={RelativeSource AncestorType={x:Type Grid}}}" />
                <Label Grid.Column="1" Text="{Binding Title}"
                       VerticalOptions="Center" Margin="16,0" FontSize="14" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <ShellContent Title="Livestock"   ContentTemplate="{DataTemplate pages:DisplayPage}"            Route="DisplayPage" />
    <ShellContent Title="Add"         ContentTemplate="{DataTemplate pages:AddLivestockPage}"       Route="AddLivestockPage" />
    <ShellContent Title="Update"      ContentTemplate="{DataTemplate pages:UpdateLivestockPage}"    Route="UpdateLivestockPage" />
    <ShellContent Title="Remove"      ContentTemplate="{DataTemplate pages:RemoveLivestockPage}"    Route="RemoveLivestockPage" />
    <ShellContent Title="Forecast"    ContentTemplate="{DataTemplate pages:ProfitForecastPage}"     Route="ProfitForecastPage" />
    <ShellContent Title="Statistics"  ContentTemplate="{DataTemplate pages:LivestockStatisticsPage}" Route="LivestockStatisticsPage" />
</Shell>